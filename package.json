{
  "name": "daily-support-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "preview:web": "expo serve",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@supabase/supabase-js": "2.112.4",
    "expo": "57.0.16",
    "expo-sqlite": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.2"
  }
}
